<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="gdufs.yixiu.dao.UsersMapper">
    <!-- SQL映射语句在此定义 -->
    <insert id="addUserByPhone" parameterType="gdufs.yixiu.pojo.Users" useGeneratedKeys="true" keyProperty="userId" keyColumn="user_id">
        insert into users(phone,username,role,avatar,last_login)
        values(#{phone},#{username},#{role},"default_avatar.jpg",NOW())
    </insert>
    <insert id="addUserByEmail" parameterType="gdufs.yixiu.pojo.Users"></insert>
    <insert id="addUserByOpenid" parameterType="gdufs.yixiu.pojo.Users"></insert>
    <select id="findUserById" resultType="gdufs.yixiu.pojo.Users" parameterType="java.lang.Integer">
        select * from users where user_id = #{userId}
    </select>
    <select id="findUserByPhoneAndRole" resultType="gdufs.yixiu.pojo.Users">
        select * from users where phone = #{phone} and role = #{role}
    </select>
</mapper>